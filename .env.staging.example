# Kestrel — PHASE 2 STAGING environment template (quarantine on a demo venue).
# Copy to .env.staging and fill the BingX VST (demo) credentials + shared DB.
#   cp .env.staging.example .env.staging
#
# What staging is:
#   ENV=staging routes to the LIVE execution code path (real order placement),
#   but TESTNET=true forces ccxt set_sandbox_mode → BingX VST (open-api-vst.bingx.com),
#   which is VIRTUAL USDT. Real fills/latency/rejections, NO real money.
#   The execution registry REFUSES to start staging with TESTNET=false, so this
#   phase can never silently touch real capital.
#
# BingX DEMO (VST) keys — your step (agent cannot create credentials):
#   1. BingX → switch to "Demo Trading" (VST) → Account → API Management.
#   2. Create an API key with Read + Trade (Spot/Perp) permissions.
#   3. Paste the key/secret below. NOTE: BingX's demo (VST) is a PERPETUAL-FUTURES
#      sandbox — there is no BingX spot demo. Staging therefore validates the
#      leveraged swap path (consistent with the 10–50x direction); §13's
#      "spot isolated margin only" needs a human CLAUDE.md amendment before go-live.

ENV=staging
BOT_ID=staging-ETHUSDT-4h-triple_mom-01   # representative fallback; bots.staging.json drives the fleet

# Execution + data feed both go to BingX. Demo execution = VST; 4h candles come
# from BingX REST (FEED_MODE=poll) because BingX's WS rejects the 4h kline.
EXCHANGE=bingx
API_KEY=your_bingx_vst_demo_key_here
API_SECRET=your_bingx_vst_demo_secret_here
TESTNET=true
FEED_MODE=poll

# Shared labs postgres — use the SAME values as the labs .env. Inside the
# kestrel_net network the host is the service name "postgres".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kestrel
DB_USER=kestrel
DB_PASSWORD=your_db_password_here

# Representative base pair/timeframe (per-bot values come from bots.staging.json).
PAIR=ETHUSDT
TIMEFRAME_ENTRY=4h
TIMEFRAME_REGIME=4h

# Leverage / capital — the validated momentum profile. Tune per your risk.
LEVERAGE=20
BUCKET_SIZE_USDT=10
MAX_ACTIVE_BUCKETS=1

# Telegram: staging is a small fleet — alerts are useful here (unlike the noisy
# labs). Fill a real token/chat to get fills, or leave the dummy to silence.
TELEGRAM_TOKEN=disabled-staging
TELEGRAM_CHAT_ID=0
LOG_LEVEL=INFO
