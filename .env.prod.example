# Kestrel PRODUCTION environment template — copy to .env on the prod VPS.
# Real capital. Every §18 go-live criterion must be met BEFORE this file is used.
# The $50 phase (owner plan 2026-07-15): ALL 22 high-win staged bots watch the
# market, but MAX_OPEN_POSITIONS_FLEET caps concurrent positions at 5 —
# many signal sources, bounded capital (5 slots × $10 buckets = $50).

ENV=prod
EXCHANGE=bingx
API_KEY=__REAL_BINGX_KEY__
API_SECRET=__REAL_BINGX_SECRET__
TESTNET=false

# MAKER EXECUTION IS MANDATORY IN PROD — the validated edge is maker-dependent
# (RESEARCH_LOOP iter 56: taker fees collapse 15/16 validated cells). Never run
# prod with this off.
MAKER_EXECUTION=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kestrel
DB_USER=kestrel
DB_PASSWORD=__CHANGE_ME__

# Fleet defined in bots.prod.json (BOT_ID/PAIR below are the single-bot fallback).
BOT_ID=prod-XRPUSDT-1h-01
PAIR=XRP/USDT
TIMEFRAME_ENTRY=1h
TIMEFRAME_REGIME=1h

LEVERAGE=20
BUCKET_SIZE_USDT=10
MAX_ACTIVE_BUCKETS=1

# Fleet-wide concurrent-position cap (owner directive 2026-07-15): the whole
# 22-bot fleet trades first-come-first-served into this many open slots.
# Capital required = cap × BUCKET_SIZE_USDT. Scale capital by raising the cap.
MAX_OPEN_POSITIONS_FLEET=5

# Perp funding (§13 v2.7) is charged by the venue in prod — no sim flag here.

TELEGRAM_TOKEN=__REAL_TOKEN__
TELEGRAM_CHAT_ID=__REAL_CHAT_ID__
LOG_LEVEL=INFO

# Portfolio guard (§17): fleet-aggregate unrealised circuit breaker.
# Owner decision for prod — staging runs 0.10/0.10; 0 = disabled.
PORTFOLIO_DD_PCT=0.10
PORTFOLIO_TP_PCT=0
