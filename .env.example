# Kestrel — environment template
# Copy to .env and fill all values before running install.sh / docker-compose up
#
# Exchange API keys — testnet (free, no real money needed for dev):
#   1. Go to https://testnet.bybit.com and create a free account
#   2. Account → API Management → Create New Key
#   3. Select "API Transaction" permissions (read + trade)
#   4. Copy the Key and Secret into API_KEY / API_SECRET below
#   For production: mainnet.bybit.com, TESTNET=false, ENV=prod
#
# Telegram bot (for trade alerts):
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message @userinfobot to get your chat ID
#
# Docker note: DB_HOST below is for bare-metal. docker-compose.yml overrides
# it to "postgres" (the service name) automatically — leave it as localhost here.

ENV=dev
BOT_ID=dev-BTCUSDT-5m-01

# EXCHANGE selects the provider (src/execution/providers/ + src/data/providers/).
#
# Crypto via ccxt (no extra install): bybit, binance, okx, kucoin, kraken, gate, mexc, bitget, bingx, huobi
#   PAIR format: BTCUSDT · ETHUSDT
#   API_KEY=<exchange api key>
#   API_SECRET=<exchange api secret>
#
# OANDA forex/CFD (pip install oandapyV20):
#   EXCHANGE=oanda
#   API_KEY=<v20 access token>       # OANDA account → Manage Funds → API Access
#   API_SECRET=<oanda account id>    # e.g. 101-001-1234567-001
#   PAIR=EUR_USD                     # underscore format: EUR_USD · GBP_JPY · BTC_USD
#   TESTNET=true                     # practice account
#
# Alpaca US stocks/crypto (pip install alpaca-py):
#   EXCHANGE=alpaca
#   API_KEY=<APCA-API-KEY-ID>
#   API_SECRET=<APCA-API-SECRET-KEY>
#   PAIR=BTC/USD                     # slash format: BTC/USD · ETH/USD · AAPL
#   TESTNET=true                     # paper trading
#
# Interactive Brokers (pip install ib_insync  +  IB Gateway/TWS running):
#   EXCHANGE=ibkr
#   API_KEY=127.0.0.1:7497           # TWS host:port (7497=live, 7496=paper; Gateway 4001/4002)
#   API_SECRET=1                     # IB client ID (integer, unique per connection)
#   PAIR=BTC.USD                     # dot format: BTC.USD · EUR.USD · AAPL.USD
#   TESTNET=true                     # routes to paper account if TWS paper port used

EXCHANGE=bybit
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
TESTNET=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kestrel
DB_USER=kestrel
DB_PASSWORD=your_db_password_here

PAIR=BTCUSDT
TIMEFRAME_ENTRY=5m
TIMEFRAME_REGIME=15m

LEVERAGE=20
BUCKET_SIZE_USDT=10.0
MAX_ACTIVE_BUCKETS=1

TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

LOG_LEVEL=DEBUG

# Grafana dashboard (served at kestrel.casava.space behind caddy)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password
